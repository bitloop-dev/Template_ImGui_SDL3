{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg-configuration.schema.json",
  "name": "app",
  "version-string": "0.1.0",
  "dependencies": [
    { "name": "glad", "platform": "!emscripten" },
    { "name": "sdl3", "platform": "!emscripten" },
    {
      "name": "sdl3",
      "platform": "emscripten",
      "features": ["emscripten-pthreads"]
    },
    "freetype",
    "nanosvg",
    "libwebp",
    "stb",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "freetype",
        "sdl3-binding",
        "opengl3-binding"
      ]
    }
  ]
}
